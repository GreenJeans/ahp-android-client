<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- To list the browsers on the phone, for the one links open in. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
    </queries>

    <!--
        Cleartext is allowed because a network security configuration cannot name an address range, and a host added by address
        (ahpd on a laptop) is reached by a private IP. Which addresses may be used unencrypted is decided in code instead: HostAddress
        accepts ws:// only for this phone and private networks, DirectHostConnector checks it again on every connection, and every
        other URL the app opens is https (the shared HTTP client does not follow a redirect to http).
    -->
    <application
        android:name=".AhpApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="AHP Client"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        tools:ignore="InsecureBaseConfiguration"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Runs as specialUse on Android 14+ (dataSync is cut after about six hours on Android 15) and as dataSync on 10 to 13. -->
        <service
            android:name=".monitor.MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live connection to the user's own coding-agent host, to alert when a session needs them" />
        </service>
        <!-- Reached only by this app's own notification (immutable intents), never by another app. -->
        <activity
            android:name=".monitor.ApproveActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name=".monitor.DecisionReceiver"
            android:exported="false" />
    </application>

</manifest>
